    {
      "id": 8,
      "type": "timeseries",
      "title": "Saturação",
      "description": "Fração das vagas de inferência ocupadas por réplica.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(inference_slots_in_use{ambiente=\"$ambiente\"} / inference_slots_max{ambiente=\"$ambiente\"})",
          "legendFormat": "vagas ocupadas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
