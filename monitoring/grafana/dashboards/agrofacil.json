          "expr": "sum(rate(http_requests_total{ambiente=\"$ambiente\",status=~\"5..\"}[1m])) or vector(0)",
          "legendFormat": "5xx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{ambiente=\"$ambiente\",status=~\"4..\"}[1m])) or vector(0)",
          "legendFormat": "4xx",
          "refId": "B"
