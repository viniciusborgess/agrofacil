          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{ambiente=\"$ambiente\",route=\"/v1/detections\"}[2m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
